{
  "_comment": "AI Lead Finder Configuration Example",
  "_instructions": "Copy this to config.json and customize for your AI automation agency",

  "lead_search": {
    "enabled": true,
    "keywords": [
      "pay for AI automation",
      "looking for AI automation",
      "need AI automation help",
      "hire AI automation",
      "AI automation services",
      "automation project",
      "AI automation budget",
      "automation freelancer",
      "AI automation contractor",
      "automation consultant",
      "AI automation expert",
      "automation setup",
      "AI automation implementation",
      "automation workflow",
      "AI automation tools"
    ],
    "max_posts_per_source": 50,
    "max_interactions": 10,
    "output_file": "ai_automation_leads.csv",
    "platforms": [
      "reddit",
      "twitter",
      "linkedin", 
      "facebook"
    ],
    "search_frequency_hours": 24,
    "_note": "Lead search finds people willing to pay for AI automation services"
  },

  "notification_preferences": {
    "email": {
      "enabled": true,
      "recipient_list": ["your-email@example.com"]
    },
    "slack": {
      "enabled": false,
      "webhook_url": "${SLACK_WEBHOOK_URL}"
    }
  },

  "proxy_settings": {
    "enabled": false,
    "http_proxy": "${HTTP_PROXY}",
    "https_proxy": "${HTTPS_PROXY}"
  },

  "_version": "1.0.0",
  "_revision_date": "2025-01-01"
}